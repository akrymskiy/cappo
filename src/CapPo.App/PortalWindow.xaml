<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CapPo.App.PortalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sign in to the network">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Sign in to the network">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Where the page is from, so a portal can't pass itself off as something else, and what CapPo is doing. -->
        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" IsEnabled="False" Click="OnBack" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Button Grid.Column="1" Click="OnReload" ToolTipService.ToolTip="Reload" AutomationProperties.Name="Reload">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="LockIcon" FontSize="12" Glyph="&#xE72E;" Visibility="Collapsed" />
                    <TextBlock x:Name="AddressText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="3" Click="OnStartOver" Content="Start over"
                ToolTipService.ToolTip="Open the page that brings up the network's sign-in page again" />
        </Grid>

        <WebView2 x:Name="Web" Grid.Row="2" />

        <InfoBar x:Name="ErrorBar" Grid.Row="2" VerticalAlignment="Top" Margin="12" IsClosable="False" Severity="Error" />

        <Grid x:Name="ConnectedPanel" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE930;" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="You're online" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="This window will close by itself." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
