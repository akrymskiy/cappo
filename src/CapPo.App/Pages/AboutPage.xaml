<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CapPo.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="32,8,32,32" Spacing="4">
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="16">
                <Image x:Name="Logo" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="CapPo" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </StackPanel>

            <Grid Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="CapPo" /><Run Text=" lets you keep encrypted DNS on (DNS over HTTPS, with no fallback to plain DNS) and still sign in to" />
                        <Run FontWeight="SemiBold" Text="Cap" /><Run Text="tive" />
                        <Run FontWeight="SemiBold" Text="Po" /><Run Text="rtals (airport, hotel, library and café Wi-Fi)." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Text="Those networks' sign-in pages only load through the network's own DNS. CapPo's sign-in window is the only thing that uses it: the window's browser sends its requests through CapPo itself (a proxy inside CapPo, reachable only from this PC), which looks names up with the network's DNS. Nothing else goes through CapPo, Windows' DNS settings are never changed, and CapPo needs no administrator rights." />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Links" />
            <Grid Style="{StaticResource CardStyle}">
                <StackPanel>
                    <HyperlinkButton x:Name="WebsiteLink" Content="CapPo's website" />
                    <HyperlinkButton x:Name="SupportLink" Content="Help and support" />
                    <HyperlinkButton x:Name="GitHubLink" Content="Source code on GitHub" />
                    <HyperlinkButton x:Name="SponsorLink" Content="Sponsor on GitHub" />
                    <HyperlinkButton x:Name="CoffeeLink" Content="Buy me a coffee" />
                    <HyperlinkButton x:Name="PrivacyLink" Content="Privacy" />
                    <HyperlinkButton Click="OnOpenDataFolder" Content="Open CapPo's folder (settings and log)" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Privacy" />
            <Grid Style="{StaticResource CardStyle}">
                <TextBlock TextWrapping="Wrap" Text="CapPo has no telemetry or analytics, and collects nothing. Its settings and log stay on this PC." />
            </Grid>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="License" />
            <Grid Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LicenseText" TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="LicenseLink" Padding="0" Content="Read the license" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
